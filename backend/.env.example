# Email provider: resend | sendgrid
EMAIL_PROVIDER=resend

# Verified sender address (e.g. Taounate Forum <booth@yourdomain.com>)
EMAIL_FROM=

# Configure the key matching EMAIL_PROVIDER (NEVER commit real keys!)
RESEND_API_KEY=
SENDGRID_API_KEY=

# Shared app secret sent in X-Client-Token header by the Taounate Booth app
CLIENT_APP_TOKEN=
